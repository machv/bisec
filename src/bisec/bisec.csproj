<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BiSec.Library</RootNamespace>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Unofficial SDK for controlling BiSecur Gateways.</Description>
		<PackageProjectUrl>https://github.com/machv/bisec</PackageProjectUrl>
		<RepositoryUrl>https://github.com/machv/bisec</RepositoryUrl>
		<Authors>Vladimír Mach</Authors>
		<Product>BiSec</Product>
		<Version>0.0.4</Version>
		<PackageVersion>0.0.4-beta</PackageVersion>

	</PropertyGroup>

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
	</ItemGroup>

</Project>
